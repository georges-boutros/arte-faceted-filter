{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "sourceMap": true,
    "declaration": false,
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "types": ["powerbi-visuals-api"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "files": ["src/visual.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", ".tmp"]
}
